{
  "id": "./",
  "name": "කතා ලියන – Sinhala Voice Typing",
  "short_name": "කතා ලියන",
  "description": "Sinhala voice typing. Speak in Sinhala, Tamil or English and get clean text with AI spelling and punctuation.",
  "lang": "si",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#eef2f0",
  "theme_color": "#0f6b55",
  "categories": ["productivity", "utilities"],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "audio",
          "accept": ["audio/*", "video/*", ".opus", ".ogg", ".oga", ".m4a", ".mp3", ".wav", ".aac", ".flac", ".webm", ".mp4"]
        }
      ]
    }
  },
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ]
}
